# exclude everything
*

# include source files
!/bin
!/crates
!/pkg
!/testing
!/.github/scripts/install_llvm_ubuntu.sh
!Cargo.lock
!Cargo.toml
!Cross.toml
!deny.toml
!Makefile
!README.md

# include for vergen constants
!/.git

# include dist directory, where the reth binary is located after compilation
!/dist

# include licenses
!LICENSE-*
!/LICENSES
!/LICENSES/**

# include example files
!/examples

# Embedded consensus packages stay in the source context; generated tests do not.
/crates/embedded-beacon/*/work
/testing/embedded-beacon/spec-tests/fixtures
/testing/embedded-beacon/spec-tests/downloads
/testing/embedded-beacon/artifacts
/testing/embedded-beacon/*/work
/testing/embedded-beacon/devnet/package/vendor
**/__pycache__
**/*.pyc
