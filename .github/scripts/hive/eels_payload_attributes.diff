+    engine_rpc.forkchoice_updated.return_value.payload_status.status = (
+        PayloadStatusEnum.VALID
+    )
+    builder = object.__new__(chain_builder_eth_rpc.ChainBuilderEthRPC)
+    builder.fork = fork
+    builder.engine_rpc = engine_rpc
+    builder._finalize_payload(
+        payload,
+        Hash(0) if fork.header_beacon_root_required() else None,
+    )
+    engine_rpc.new_payload.assert_called_once_with(
+        *fixture.params, version=int(fixture.new_payload_version)
+    )
